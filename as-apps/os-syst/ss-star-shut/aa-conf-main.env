# ss-star-shut Linux config — KEY=value, one per line. ~ and ${HOME} expand. Env var of same name overrides.
WORK_PATH=~/00_modules
CLOU_PATH=~/04-clou-base
DOWN_PATH=~/Downloads
FILE_MANA=nemo
CHRO_BINA=google-chrome
CHRO_DATA=~/.config/chrome-launchers
# Taskbar Chrome launchers (~/.local/share/applications/chrome-pN.desktop), comma list of ids, opened in this order
# p1 Mai Trang · p2 Chi Linh · p3 Noi That Dep · p4 Zzown · p5 Da Hoa Cuong · p7 Lien he · p8 Michael · default Nhap
CHRO_PROF=default,p1
CODE_BINA=code
# cmd-run server (browser tab only, never the Electron panel); empty = skip. Tab opens in the first CHRO_PROF profile
CMDR_BINA=~/00_modules/04-sche-task/zig-out/bin/cmd-run
CMDR_PORT=3030
# Chrome debug port on the FIRST profile (127.0.0.1 only) so shutdown can close the cmd-run tab first; 0 = off
CMDR_DBGP=9333
# Local AI server (llama-server): the watchdog starts it and keeps it up; empty = skip. Tunables: 04-sche-task/00-start/ai-server.env
AISV_WDOG=~/00_modules/04-sche-task/00-start/ai-lin-watchdog.sh
AISV_PORT=3010
# Vision server (reads car photos): the same watchdog with its own settings file; empty = skip
AISV_VENV=~/00_modules/04-sche-task/00-start/ai-vision.env
AISV_VPORT=3011
SYNC_BINA=~/00_modules/12-pner-apps/08-erpl-modu/82-document-storage/git-sync-safe-guard/zig-out/bin/git-sync-safe-guard
POWE_CMDZ=systemctl poweroff
# Seconds: cancel countdown · wait per app to close · gap between opens
COUN_SECO=9
WAIT_SECO=8
OPEN_GAPS=3
# Process names never closed (comma list)
SKIP_LIST=cinnamon,cinnamon-panel,nemo-desktop,cinnamon-session,Xorg,gnome-shell,plasmashell
# ru-shut-guar.sh (one hub job linu-shut-nigh, cron every 15m 23:00-02:45 only; first tick of hour GUAR_ARMH arms, later ticks check): hub port · hour (0-23) of the arming tick · hour (0-23) when it powers off even if jobs never finish · hours after that hour the arm counts as stale · its own job ids (ignored as "busy") · terminal command · arm flag file
GUAR_HUBP=3030
GUAR_ARMH=23
GUAR_FORC=2
GUAR_STAL=3
GUAR_SELF=linu-shut-nigh
GUAR_TERM=gnome-terminal --
GUAR_FLAG=~/.cmd-run/shutdown-armed
# Hub chain state folder: a <id>.chain file with a due next step counts as a running job
GUAR_STAT=~/.cmd-run/task-state
